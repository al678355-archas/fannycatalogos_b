{
  "name": "cms-catalogo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST del CMS + Catálogo (Express + Prisma + PostgreSQL/Neon)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "build": "prisma generate",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "postinstall": "prisma generate",
    "start:prod": "node scripts/migrate.js && node src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  }
}
