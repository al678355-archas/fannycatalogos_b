# ─── Servidor ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Base de datos (Neon PostgreSQL) ────────────────────────
# Conexión con pooling (host con "-pooler"), usada por la app en runtime
DATABASE_URL="postgresql://USUARIO:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Conexión directa (host sin "-pooler"), usada por las migraciones (opcional: si falta se usa DATABASE_URL)
DIRECT_URL="postgresql://USUARIO:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── Autenticación ──────────────────────────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# lax (recomendado si el frontend hace proxy de /api) | none (dominios distintos, requiere HTTPS)
COOKIE_SAMESITE=lax

# ─── URLs ───────────────────────────────────────────────────
# Orígenes permitidos por CORS (separados por coma, sin "/" al final). El primero se usa como URL pública.
FRONTEND_URL=http://localhost:5173
# URL pública de este backend (se usa para construir URLs absolutas de imágenes locales)
BACKEND_URL=http://localhost:4000

# ─── Almacenamiento de imágenes ─────────────────────────────
# local | cloudinary
STORAGE_DRIVER=local
MAX_UPLOAD_MB=5

# Sólo si STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cms-catalogo
